<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.company.web</groupId>
    <artifactId>web-workspace</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>common-js-web</module>
        <module>module-web</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.version>3.11.0</maven.compiler.version>

        <!-- Spring 5 keeps this workspace on the javax.servlet stack used by Jetty 10. -->
        <spring.version>5.3.39</spring.version>
        <servlet.api.version>4.0.1</servlet.api.version>

        <!-- Compatible with Maven 3.5.4 -->
        <maven.antrun.version>3.1.0</maven.antrun.version>
        <maven.war.version>3.3.2</maven.war.version>

        <!-- Node installation -->
        <node.home>D:\node-v22.19.0-win-x64</node.home>
        <npm.executable>${node.home}\npm.cmd</npm.executable>
    </properties>
</project>
